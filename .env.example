# Modelos sem segredo. Copie o arquivo do workspace que for usar.
# Nunca commite .env, .jks, .keystore ou token.

# Servidor local: signaling-server/.env
# PORT=8080
# HOST=0.0.0.0
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=

# Build do app: desktop-app/.env
# VITE_SIGNALING_URL=wss://seu-servidor.up.railway.app
# VITE_APP_VERSION=1.6.0

# GitHub Actions (secrets do repositório, não deste arquivo):
# VITE_SIGNALING_URL
# ANDROID_KEYSTORE_BASE64
# ANDROID_KEYSTORE_PASSWORD
# ANDROID_KEY_ALIAS
# ANDROID_KEY_PASSWORD

# Railway (variáveis do serviço signaling-server):
# PORT
# HOST
# CF_TURN_KEY_ID
# CF_TURN_API_TOKEN
