# Lido pelo Vite no build e no dev. Não coloque token aqui.
# A URL publicada sai da secret VITE_SIGNALING_URL no GitHub Actions.
VITE_SIGNALING_URL=ws://localhost:8080

# Versão embutida no bundle mobile para o aviso de atualização do Android.
# No CI ela vem da tag. Localmente o vite.config.mobile.ts cai no package.json.
VITE_APP_VERSION=1.6.0
